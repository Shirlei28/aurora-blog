---
import type { Post } from '@/lib/posts';
import { getPostHref } from '@/lib/posts';

interface Props {
  posts: Post[];
  currentId?: string;
}

const { posts, currentId } = Astro.props;
const year = 2026;
const yearPosts = posts.filter((post) => post.data.pubDate.getFullYear() === year);
---
<aside class="article-sidebar" aria-label="2026 文章导航">
  <div class="article-sidebar-inner">
    <div class="sidebar-posts sidebar-posts-only">
      <details open>
        <summary>{year}</summary>
        <div class="sidebar-year-posts">
          {yearPosts.map((post) => (
            <a
              class:list={['sidebar-post-link', post.id === currentId && 'is-active']}
              href={getPostHref(post)}
              aria-current={post.id === currentId ? 'page' : undefined}
            >
              {post.data.title}
            </a>
          ))}
        </div>
      </details>
    </div>
  </div>
</aside>
