---
import { SITE } from '@/lib/config';
import { getPublishedPosts, getPostHref } from '@/lib/posts';
import SearchDialog from './SearchDialog.astro';
import ThemeToggle from './ThemeToggle.astro';

const posts = await getPublishedPosts();
const latestPostHref = posts[0] ? getPostHref(posts[0]) : '/posts/';
---
<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label={`${SITE.title} 首页`}>
      <img
        class="brand-logo brand-logo-light"
        src="/logo.svg"
        alt=""
        width="32"
        height="32"
      />

      <img
        class="brand-logo brand-logo-dark"
        src="/logo-dark.svg"
        alt=""
        width="32"
        height="32"
      />

      <span>
        <strong>{SITE.title}</strong>
      </span>
    </a>
  

    <button class="nav-toggle" type="button" aria-controls="site-nav" aria-expanded="false" aria-label="打开菜单">
      <span></span><span></span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="主导航">
      {SITE.nav
        .filter((item) => item.href !== '/' && item.href !== '/notes/')
        .map((item) => {
          const href = item.href === '/posts/' ? latestPostHref : item.href;
          return <a href={href}>{item.label}</a>;
        })}
      <SearchDialog />
      <ThemeToggle />
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.querySelector<HTMLElement>('#site-nav');
  const header = document.querySelector<HTMLElement>('.site-header');
  const desktopQuery = window.matchMedia('(min-width: 901px)');

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    nav?.classList.toggle('is-open', !expanded);
  });

  let lastScrollY = window.scrollY;
  let ticking = false;

  const showHeader = () => {
    header?.classList.remove('is-hidden');
    document.documentElement.classList.remove('header-hidden');
  };

  const hideHeader = () => {
    header?.classList.add('is-hidden');
    document.documentElement.classList.add('header-hidden');
  };

  const updateHeader = () => {
    const currentScrollY = Math.max(window.scrollY, 0);

    if (!desktopQuery.matches) {
      showHeader();
      lastScrollY = currentScrollY;
      ticking = false;
      return;
    }

    if (currentScrollY <= 24) {
      showHeader();
      lastScrollY = currentScrollY;
      ticking = false;
      return;
    }

    const delta = currentScrollY - lastScrollY;

    if (Math.abs(delta) >= 8) {
      if (delta > 0) {
        hideHeader();
      } else {
        showHeader();
      }
      lastScrollY = currentScrollY;
    }

    ticking = false;
  };

  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        window.requestAnimationFrame(updateHeader);
        ticking = true;
      }
    },
    { passive: true }
  );

  desktopQuery.addEventListener('change', () => {
    showHeader();
    lastScrollY = window.scrollY;
  });
</script>
