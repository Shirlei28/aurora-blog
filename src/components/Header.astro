---
import { SITE } from '@/lib/config';
import { getPublishedPosts, getPostHref } from '@/lib/posts';
import SearchDialog from './SearchDialog.astro';
import ThemeToggle from './ThemeToggle.astro';

const posts = await getPublishedPosts();
const latestPostHref = posts[0] ? getPostHref(posts[0]) : '/posts/';

const postsByYear = posts.reduce((groups, post) => {
  const year = post.data.pubDate.getFullYear();
  const current = groups.get(year) ?? [];
  current.push(post);
  groups.set(year, current);
  return groups;
}, new Map<number, typeof posts>());
---
<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label={`${SITE.title} 首页`}>
      <img
        class="brand-logo brand-logo-light"
        src="/logo.svg"
        alt=""
        width="32"
        height="32"
      />

      <img
        class="brand-logo brand-logo-dark"
        src="/logo-dark.svg"
        alt=""
        width="32"
        height="32"
      />

      <span>
        <strong>{SITE.title}</strong>
      </span>
    </a>
  

    <button class="nav-toggle" type="button" aria-controls="site-nav" aria-expanded="false" aria-label="打开菜单">
      <span></span><span></span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="主导航">
      {SITE.nav
        .filter((item) =>
          item.href !== '/' &&
          item.href !== '/notes/' &&
          item.href !== '/categories/' &&
          item.href !== '/tags/'
        )
        .map((item) => {
          if (item.href === '/posts/') {
            return (
              <>
                <a class="desktop-posts-link" href={latestPostHref}>{item.label}</a>

                <details class="mobile-posts-menu">
                  <summary>{item.label}</summary>

                  <div class="mobile-posts-scroll">
                    {[...postsByYear.entries()].map(([year, yearPosts]) => (
                      <section class="mobile-posts-year">
                        <p>{year}</p>

                        <div class="mobile-posts-list">
                          {yearPosts.map((post) => (
                            <a href={getPostHref(post)}>{post.data.title}</a>
                          ))}
                        </div>
                      </section>
                    ))}
                  </div>
                </details>
              </>
            );
          }

          return <a href={item.href}>{item.label}</a>;
        })}
      <SearchDialog />
      <ThemeToggle />
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.querySelector<HTMLElement>('#site-nav');
  const header = document.querySelector<HTMLElement>('.site-header');

  let lastScrollY = window.scrollY;
  let ticking = false;

  const showHeader = () => {
    header?.classList.remove('is-hidden');
    document.documentElement.classList.remove('header-hidden');
  };

  const hideHeader = () => {
    if (nav?.classList.contains('is-open')) return;

    header?.classList.add('is-hidden');
    document.documentElement.classList.add('header-hidden');
  };

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    const nextExpanded = !expanded;

    toggle.setAttribute('aria-expanded', String(nextExpanded));
    nav?.classList.toggle('is-open', nextExpanded);

    if (nextExpanded) {
      showHeader();
    }
  });

  const updateHeader = () => {
    const currentScrollY = Math.max(window.scrollY, 0);

    if (currentScrollY <= 24) {
      showHeader();
      lastScrollY = currentScrollY;
      ticking = false;
      return;
    }

    if (nav?.classList.contains('is-open')) {
      showHeader();
      lastScrollY = currentScrollY;
      ticking = false;
      return;
    }

    const delta = currentScrollY - lastScrollY;

    if (Math.abs(delta) >= 8) {
      if (delta > 0) {
        hideHeader();
      } else {
        showHeader();
      }

      lastScrollY = currentScrollY;
    }

    ticking = false;
  };

  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        window.requestAnimationFrame(updateHeader);
        ticking = true;
      }
    },
    { passive: true }
  );
</script>
