---
import type { CollectionEntry } from 'astro:content';
import { formatShortDate, getPostHref, getReadingTime } from '@/lib/posts';

interface Props {
  post: CollectionEntry<'blog'>;
  compact?: boolean;
}

const { post, compact = false } = Astro.props;
---
<article class:list={['article-card', { compact }]}>
  {post.data.cover && !compact && (
    <a class="article-cover" href={getPostHref(post)} aria-label={post.data.title}>
      <img src={post.data.cover} alt={post.data.coverAlt || ''} loading="lazy" />
    </a>
  )}
  <div class="article-card-body">
    <div class="article-meta">
      <span>{formatShortDate(post.data.pubDate)}</span>
      <span>·</span>
      <a href={`/categories/${encodeURIComponent(post.data.category)}/`}>{post.data.category}</a>
      <span>·</span>
      <span>{getReadingTime(post)}</span>
    </div>
    <h3><a href={getPostHref(post)}>{post.data.title}</a></h3>
    <p>{post.data.description}</p>
    <div class="tag-row">
      {post.data.tags.slice(0, compact ? 2 : 4).map((tag) => (
        <a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>
      ))}
    </div>
  </div>
</article>
