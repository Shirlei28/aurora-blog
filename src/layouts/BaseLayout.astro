---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { DYNAMIC, SITE } from '@/lib/config';
import { absoluteUrl } from '@/lib/seo';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  article?: boolean;
}

const {
  title = SITE.title,
  description = SITE.description,
  canonical = Astro.url.pathname,
  image,
  article = false
} = Astro.props;

const canonicalUrl = absoluteUrl(canonical);
const imageUrl = image ? absoluteUrl(image) : undefined;
---
<!doctype html>
<html lang="zh-CN" data-theme="system">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f3f0e8" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={absoluteUrl('/rss.xml')} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content={SITE.locale} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}

    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}

    {DYNAMIC.umamiSrc && DYNAMIC.umamiWebsiteId && (
      <script is:inline defer src={DYNAMIC.umamiSrc} data-website-id={DYNAMIC.umamiWebsiteId}></script>
    )}

    <title>{title}</title>
    <slot name="head" />
  </head>
  <body class="site-body">
    <Header />

    <main class="site-main">
      <slot />
    </main>

    <Footer />
  </body>
</html>
