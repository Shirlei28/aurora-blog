---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AtomAnimation from '@/components/AtomAnimation.astro';
import { getPublishedPosts, getPostHref } from '@/lib/posts';
import { SITE } from '@/lib/config';

const posts = await getPublishedPosts();
const latestPostHref = posts[0] ? getPostHref(posts[0]) : '/posts/';
---

<BaseLayout description={SITE.description}>
  <main class="home-landing">
    <div class="home-atom-shell" aria-hidden="true">
      <AtomAnimation size="home" />
    </div>

    <a class="home-welcome" href={latestPostHref} aria-label="进入文章">
      <span>欢迎</span>
    </a>
  </main>
</BaseLayout>
