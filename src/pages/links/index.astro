---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';

const links = await getCollection('links');
---

<BaseLayout title="链接 | Aurora Blog" description="Aurora Blog 收藏的网站与朋友。">
  <main class="links-page shell">
    <section class="links-grid-v2">
      {links.map((link) => (
        <a
          class="link-item"
          href={link.data.url}
          target="_blank"
          rel="noreferrer noopener"
        >
          <div class="link-mark">
            {link.data.name.slice(0, 1)}
          </div>

          <div class="link-content">
            <h2>{link.data.name}</h2>
            <p>{link.data.description}</p>
          </div>

          <span class="link-arrow">↗</span>
        </a>
      ))}
    </section>
  </main>
</BaseLayout>
