---
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout title="页面不存在 | Aurora Blog" description="你访问的页面不存在。">
  <section class="page-intro shell error-page">
    <p class="eyebrow">404</p>
    <h1>这页走丢了。</h1>
    <p>可能链接已经更新，也可能你来到了一个从未存在过的地方。</p>
    <a class="button button-primary" href="/">回到首页</a>
  </section>
</BaseLayout>
