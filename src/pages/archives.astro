---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPublishedPosts, getPostHref } from '@/lib/posts';

const posts = await getPublishedPosts();

const groups = new Map<number, typeof posts>();

for (const post of posts) {
  const year = post.data.pubDate.getFullYear();
  const list = groups.get(year) ?? [];
  list.push(post);
  groups.set(year, list);
}
---

<BaseLayout title="Archive">
  <main class="archive-page shell">
    <div class="archive-list">
      {[...groups.entries()].sort((a, b) => b[0] - a[0]).map(([year, yearPosts]) => (
        <section class="archive-year">
          <h1>{year}</h1>

          <div class="archive-posts">
            {yearPosts
              .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
              .map((post) => (
                <a class="archive-post" href={getPostHref(post)}>
                  <time>
                    {post.data.pubDate.getMonth() + 1}月{post.data.pubDate.getDate()}日
                  </time>
                  <span>{post.data.title}</span>
                </a>
              ))}
          </div>
        </section>
      ))}
    </div>
  </main>
</BaseLayout>
