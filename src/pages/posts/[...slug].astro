---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleSidebar from '@/components/ArticleSidebar.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import Comments from '@/components/Comments.astro';
import ArticleProgress from '@/components/ArticleProgress.astro';
import MobileTableOfContents from '@/components/MobileTableOfContents.astro';
import RelatedPosts from '@/components/RelatedPosts.astro';
import BackToTop from '@/components/BackToTop.astro';
import { SITE } from '@/lib/config';
import { articleJsonLd, absoluteUrl } from '@/lib/seo';
import { formatDate, getPublishedPosts, getPostHref, getReadingTime } from '@/lib/posts';
import MediaEnhancer from '@/components/MediaEnhancer.astro';
import '@/styles/article.css';
import ExternalLinks from '@/components/ExternalLinks.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => import.meta.env.PROD ? !data.draft : true);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post }
  }));
}

type Props = { post: CollectionEntry<'blog'> };
const { post } = Astro.props as Props;
const { Content, headings } = await render(post);
const posts = await getPublishedPosts();
const index = posts.findIndex((item) => item.id === post.id);
const previous = posts[index + 1];
const next = posts[index - 1];
const canonical = post.data.canonical || getPostHref(post);
const jsonLd = articleJsonLd({
  title: post.data.title,
  description: post.data.description,
  url: absoluteUrl(canonical),
  datePublished: post.data.pubDate,
  ...(post.data.updatedDate ? { dateModified: post.data.updatedDate } : {}),
  ...(post.data.cover ? { image: post.data.cover } : {})
});
---
<BaseLayout
  title={`${post.data.title} | ${SITE.title}`}
  description={post.data.description}
  canonical={canonical}
  {...(post.data.cover ? { image: post.data.cover } : {})}
  article
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  </Fragment>

  <ArticleProgress />

  <div class="reading-workspace">
    <ArticleSidebar posts={posts} currentId={post.id} />

    <div class="reading-main">
      <details class="mobile-article-nav">
        <summary>2026 文章</summary>
        <div class="mobile-article-nav-links mobile-post-list">
          {posts
            .filter((item) => item.data.pubDate.getFullYear() === 2026)
            .map((item) => (
              <a
                class:list={[item.id === post.id && 'is-active']}
                href={getPostHref(item)}
                aria-current={item.id === post.id ? 'page' : undefined}
              >
                {item.data.title}
              </a>
            ))}
        </div>
      </details>

      <article class="reading-article">
        <header class="reading-header reading-header-minimal">
          <h1>{post.data.title}</h1>
          <div class="article-meta article-meta-minimal">
            <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
            <span>·</span>
            <span>阅读约 {getReadingTime(post)}</span>
          </div>

          {post.data.cover && (
            <figure class="reading-cover">
              <img src={post.data.cover} alt={post.data.coverAlt || ''} loading="eager" />
            </figure>
          )}
        </header>

        {post.data.toc && <MobileTableOfContents headings={headings} />}

        <div class="post-content prose reading-prose" data-reading-content>
          <Content />
        </div>

        <div class="post-footer-block reading-footer-block">
          <div class="post-nav">
            {previous ? <a href={getPostHref(previous)}><small>上一篇</small><strong>← {previous.data.title}</strong></a> : <span></span>}
            {next ? <a class="post-nav-next" href={getPostHref(next)}><small>下一篇</small><strong>{next.data.title} →</strong></a> : <span></span>}
          </div>

          <RelatedPosts current={post} posts={posts} />
          {post.data.comments && <Comments />}
        </div>
      </article>
    </div>

    <div class="reading-toc-column">
      {post.data.toc && <TableOfContents headings={headings} />}
    </div>
  </div>

  <BackToTop />
  <MediaEnhancer />
  <ExternalLinks />
</BaseLayout>
