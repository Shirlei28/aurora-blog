---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleSidebar from '@/components/ArticleSidebar.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import Comments from '@/components/Comments.astro';
import ArticleProgress from '@/components/ArticleProgress.astro';
import MobileTableOfContents from '@/components/MobileTableOfContents.astro';
import RelatedPosts from '@/components/RelatedPosts.astro';
import BackToTop from '@/components/BackToTop.astro';
import { SITE } from '@/lib/config';
import { articleJsonLd, absoluteUrl } from '@/lib/seo';
import { formatDate, getPublishedPosts, getPostHref, getReadingTime } from '@/lib/posts';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => import.meta.env.PROD ? !data.draft : true);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post }
  }));
}

type Props = { post: CollectionEntry<'blog'> };
const { post } = Astro.props as Props;
const { Content, headings } = await render(post);
const posts = await getPublishedPosts();
const index = posts.findIndex((item) => item.id === post.id);
const previous = posts[index + 1];
const next = posts[index - 1];
const canonical = post.data.canonical || getPostHref(post);
const jsonLd = articleJsonLd({
  title: post.data.title,
  description: post.data.description,
  url: absoluteUrl(canonical),
  datePublished: post.data.pubDate,
  dateModified: post.data.updatedDate,
  image: post.data.cover
});
---
<BaseLayout
  title={`${post.data.title} | ${SITE.title}`}
  description={post.data.description}
  canonical={canonical}
  image={post.data.cover}
  article
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  </Fragment>

  <ArticleProgress />

  <div class="reading-workspace">
    <ArticleSidebar posts={posts} currentId={post.id} />

    <div class="reading-main">
      <details class="mobile-article-nav">
        <summary>文章导航</summary>
        <div class="mobile-article-nav-links">
          <a href="/posts/">全部文章</a>
          <a href="/archives/">归档</a>
          <a href="/categories/">分类</a>
          <a href="/tags/">标签</a>
          <a href="/notes/">随记</a>
        </div>
      </details>

      <article class="reading-article">
        <header class="reading-header">
          <div class="article-meta">
            <a href={`/categories/${encodeURIComponent(post.data.category)}/`}>{post.data.category}</a>
            <span>·</span>
            <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
            <span>·</span>
            <span>阅读约 {getReadingTime(post)}</span>
          </div>
          <h1>{post.data.title}</h1>
          <p class="post-lead">{post.data.description}</p>
          <div class="tag-row">
            {post.data.tags.map((tag) => <a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>)}
          </div>
          {post.data.cover && (
            <figure class="reading-cover">
              <img src={post.data.cover} alt={post.data.coverAlt || ''} loading="eager" />
            </figure>
          )}
        </header>

        {post.data.toc && <MobileTableOfContents headings={headings} />}

        <div class="post-content prose reading-prose" data-reading-content>
          <Content />
        </div>

        <div class="post-footer-block reading-footer-block">
          <div class="post-nav">
            {previous ? <a href={getPostHref(previous)}><small>上一篇</small><strong>← {previous.data.title}</strong></a> : <span></span>}
            {next ? <a class="post-nav-next" href={getPostHref(next)}><small>下一篇</small><strong>{next.data.title} →</strong></a> : <span></span>}
          </div>

          <RelatedPosts current={post} posts={posts} />
          {post.data.comments && <Comments />}
        </div>
      </article>
    </div>

    <div class="reading-toc-column">
      {post.data.toc && <TableOfContents headings={headings} />}
    </div>
  </div>

  <BackToTop />
</BaseLayout>
